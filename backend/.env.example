APP_ENV=development
API_V1_PREFIX=/api/v1
MODEL_AUTOLOAD=true

# Paths can be absolute or relative to the current working directory.
DATASET_PATH=backend/datasets/credit_risk_dataset.csv
MODEL_PATH=backend/models/credit_risk_model.joblib

# Expo + web dev origins
CORS_ALLOW_ORIGINS=http://localhost:19006,http://127.0.0.1:19006,http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:19000,exp://localhost:19000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
