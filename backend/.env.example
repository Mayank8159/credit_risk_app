APP_ENV=development
API_V1_PREFIX=/api/v1
MODEL_AUTOLOAD=true

# Paths can be absolute or relative to the current working directory.
DATASET_PATH=backend/datasets/credit_risk_dataset.csv
MODEL_PATH=backend/models/credit_risk_model.joblib

# Expo + web dev origins
CORS_ALLOW_ORIGINS=http://localhost:19006,http://127.0.0.1:19006,http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:19000,exp://localhost:19000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Optional keep-warm timer (best effort). For Render set KEEP_WARM_URL to your deployed /health URL.
ENABLE_KEEP_WARM_TIMER=false
KEEP_WARM_INTERVAL_SECONDS=50
KEEP_WARM_URL=
KEEP_WARM_TIMEOUT_SECONDS=10

# Optional: backend-only Gemini key for enhanced AI Credit Coach responses.
# Leave empty to use deterministic rule-based fallback.
GOOGLE_API_KEY=
