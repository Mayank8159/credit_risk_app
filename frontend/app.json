{
  "expo": {
    "name": "Credit Risk App",
    "slug": "credit-risk-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/applogo1.png",
    "splash": {
      "image": "./assets/applogo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo1.png",
        "backgroundColor": "#4A90E2"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/applogo1.png"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
