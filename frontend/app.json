{
  "expo": {
    "name": "Credit Risk App",
    "slug": "credit-risk-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/applogo1.png",
    "splash": {
      "image": "./assets/applogo1.png",
      "resizeMode": "cover",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo1.png",
        "backgroundColor": "#4A90E2"
      },
      "package": "com.mayank8159.creditriskapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/applogo1.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "43912bed-0040-4a44-a50c-a43e57585a79"
      }
    }
  }
}
